From 053770be23c7826efefa9b7b087d8b285bf8bbcd Mon Sep 17 00:00:00 2001
From: Jae Hyun Yoo <jae.hyun.yoo@intel.com>
Date: Wed, 29 Jan 2020 14:55:44 -0800
Subject: [PATCH] ast2600: Override OTP strap settings

This commit adds settings to override OTP strap.
Also, this commit disables SoC debug interface.

Signed-off-by: Jae Hyun Yoo <jae.hyun.yoo@intel.com>
Upstream-Status: Pending

---
 arch/arm/mach-aspeed/ast2600/platform.S | 22 ++++++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/arch/arm/mach-aspeed/ast2600/platform.S b/arch/arm/mach-aspeed/ast2600/platform.S
index 15edb58632..9e239f9345 100644
--- a/arch/arm/mach-aspeed/ast2600/platform.S
+++ b/arch/arm/mach-aspeed/ast2600/platform.S
@@ -49,7 +49,9 @@
 #define SCU_HPLL_PARAM_EXT	(SCU_BASE + 0x204)
 #define SCU_USB_MULTI_FUNC	(SCU_BASE + 0x440)
 #define SCU_HW_STRAP1		(SCU_BASE + 0x500)
+#define SCU_HW_STRAP1_CLR	(SCU_BASE + 0x504)
 #define SCU_HW_STRAP2		(SCU_BASE + 0x510)
+#define SCU_HW_STRAP2_CLR	(SCU_BASE + 0x514)
 #define SCU_HW_STRAP3		(SCU_BASE + 0x51c)
 #define SCU_CA7_PARITY_CHK	(SCU_BASE + 0x820)
 #define SCU_CA7_PARITY_CLR	(SCU_BASE + 0x824)
@@ -190,6 +192,26 @@ do_primary_core_setup:
 	/* unlock system control unit */
 	scu_unlock
 
+	/* disable CA7 CPU boot */
+	ldr	r0, =SCU_HW_STRAP1_CLR
+	movw	r1, #0x0001		@; Disable ARM CA7 CPU boot
+	movt	r1, #0x0000
+	str	r1, [r0]
+
+	/* enable eSPI, debug interface and disable UART5 boot */
+	ldr	r0, =SCU_HW_STRAP2_CLR
+	movw	r1, #0x0040		@; Select eSPI
+	movt	r1, #0x0000
+	orr	r1, #0x0010		@; Enable debug interface
+	orr	r1, #0x0100		@; Disable UART5 boot
+	str	r1, [r0]
+
+	/* enable ACPI */
+	ldr	r0, =SCU_HW_STRAP2
+	ldr	r1, [r0]
+	orr	r1, #0x20		@; Enable ACPI
+	str	r1, [r0]
+
 	/* identify AST2600 A0/A1 */
 	ldr	r0, =SCU_REV_ID
 	ldr	r0, [r0]
-- 
2.34.1

