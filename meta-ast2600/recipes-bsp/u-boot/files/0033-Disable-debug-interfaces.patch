From 7a0f0e0915c7d9260a3d067746157112f85822db Mon Sep 17 00:00:00 2001
From: Chen Yugang <yugang.chen@linux.intel.com>
Date: Fri, 11 Jun 2021 12:44:25 +0800
Subject: [PATCH] Disable debug interfaces

1.Disable ARM Core CA7 debug features in
SCU800: CA7 processor Control
2.Disable Mailbox Write/Disable in PDSEF0: PCIe
Device Security Enhancement Control Register F0
3.Disable target AHB to PCIE RC bridge controller
in AHBC88: AHB Bus Target Disable Control Register

Signed-off-by: Chen Yugang <yugang.chen@linux.intel.com>
Upstream-Status: Pending

---
 arch/arm/mach-aspeed/ast2600/platform.S | 34 +++++++++++++++++++++++++
 1 file changed, 34 insertions(+)

diff --git a/arch/arm/mach-aspeed/ast2600/platform.S b/arch/arm/mach-aspeed/ast2600/platform.S
index d3a066f0e6..34673ebc7a 100644
--- a/arch/arm/mach-aspeed/ast2600/platform.S
+++ b/arch/arm/mach-aspeed/ast2600/platform.S
@@ -30,6 +30,9 @@
  * +----------------------+ SCU180
  */
 
+#define AHBC_BASE		0x1e600000
+#define AHBC_BUS_TARGET_CTRL	(AHBC_BASE + 0x088)
+
 #define SCU_BASE		0x1e6e2000
 #define SCU_PROT_KEY1		(SCU_BASE)
 #define SCU_PROT_KEY2		(SCU_BASE + 0x010)
@@ -55,6 +58,7 @@
 #define SCU_HW_STRAP2		(SCU_BASE + 0x510)
 #define SCU_HW_STRAP2_CLR	(SCU_BASE + 0x514)
 #define SCU_HW_STRAP3		(SCU_BASE + 0x51c)
+#define SCU_CA7_PROCESSOR_CTRL	(SCU_BASE + 0x800)
 #define SCU_CA7_PARITY_CHK	(SCU_BASE + 0x820)
 #define SCU_CA7_PARITY_CLR	(SCU_BASE + 0x824)
 #define SCU_MMIO_DEC_SET	(SCU_BASE + 0xc24)
@@ -88,6 +92,9 @@
 #define LPC_BASE		0x1e789000
 #define LPC_HICRA		(LPC_BASE + 0x09c)
 
+#define PCIEATH_BASE		0x1e7f2000
+#define PCIEATH_SECURITY_CTRL	(PCIEATH_BASE + 0x0f0)
+
 #define SEC_BASE		0x1e6f2000
 #define SEC_VAULT_KEY_CTRL	(SEC_BASE + 0x80c)
 
@@ -440,6 +447,33 @@ skip_fill_wip_bit:
 	moveq	r1, #0xff
 	str	r1, [r0]
 
+	/* disable debug interfaces */
+	/* SCU_800 */
+	ldr	r0, =SCU_CA7_PROCESSOR_CTRL
+	ldr	r1, [r0]
+	ldr	r2, =0x0c03f
+	and	r1, r1, r2
+	str	r1, [r0]
+
+	/* PCIEATH_F0 */
+	ldr	r0, =PCIEATH_SECURITY_CTRL
+	ldr	r1, [r0]
+	orr	r1, #0x50000
+	str	r1, [r0]
+
+	/* AHBC_088 */
+	ldr	r0, =AHBC_BASE
+	movw	r1, #0x1a03
+	movt	r1, #0xaeed
+	str	r1, [r0]
+	ldr	r0, =AHBC_BUS_TARGET_CTRL
+	ldr	r1, [r0]
+	orr	r1, #0xc0000
+	str	r1, [r0]
+	ldr	r0, =AHBC_BASE
+	movw	r1, #0
+	str	r1, [r0]
+
 	/* set UART routing back to default */
 	ldr	r0, =LPC_HICRA
 	mov	r1, #0
-- 
2.34.1

