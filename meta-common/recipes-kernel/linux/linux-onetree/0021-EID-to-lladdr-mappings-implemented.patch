From 3b98fceb5d395470f0d03301068dbd094b5c4cfd Mon Sep 17 00:00:00 2001
From: ShengHsiuHuang <ShengHsiuHuang@ami.com>
Date: Mon, 30 Mar 2026 23:46:21 +0800
Subject: [PATCH 4/5] EID to lladdr mappings implemented

---
 include/net/mctp.h |   2 +
 net/mctp/af_mctp.c | 177 +++++++++++++++++++++++++++++++++++++++++++++
 net/mctp/route.c   |  39 ++++++++++
 3 files changed, 218 insertions(+)

diff --git a/include/net/mctp.h b/include/net/mctp.h
index c3207ce98f07..6705a0c848f4 100644
--- a/include/net/mctp.h
+++ b/include/net/mctp.h
@@ -329,6 +329,8 @@ int mctp_neigh_lookup(struct mctp_dev *dev, mctp_eid_t eid,
 		      void *ret_hwaddr);
 void mctp_neigh_remove_dev(struct mctp_dev *mdev);
 
+int mctp_pid_map_lookup(const void *pid, mctp_eid_t *eid_out);
+
 int mctp_routes_init(void);
 void mctp_routes_exit(void);
 
diff --git a/net/mctp/af_mctp.c b/net/mctp/af_mctp.c
index b99ba14f39d2..ecb0073c5cb2 100644
--- a/net/mctp/af_mctp.c
+++ b/net/mctp/af_mctp.c
@@ -20,6 +20,177 @@
 #define CREATE_TRACE_POINTS
 #include <trace/events/mctp.h>
 
+/* implement userdefined mappings for eids and lladdr*/
+#define MCTP_EID_INVALID 0
+
+#define SIOCMCTPSETPIDMAP  _IOW('m', 1, struct mctp_pid_map_req)
+#define SIOCMCTPDELPIDMAP  _IOW('m', 2, mctp_eid_t)
+#define SIOCMCTPGETPIDMAP  _IOR('m', 3, struct mctp_pid_map_bulk)
+
+#define MAX_PID_MAP_ENTRIES 64
+
+struct mctp_pid_map_entry_user {
+	mctp_eid_t eid;
+	unsigned char pid[6];
+};
+
+struct mctp_pid_map_bulk {
+	__u32 count;  // in/out
+	struct mctp_pid_map_entry_user entries[MAX_PID_MAP_ENTRIES];
+};
+
+struct mctp_pid_map_entry {
+	mctp_eid_t eid;
+	unsigned char pid[6];
+	struct list_head list;
+};
+
+struct mctp_pid_map_req {
+	mctp_eid_t eid;
+	unsigned char pid[6];
+};
+
+struct mctp_pid_only {
+	unsigned char pid[6];
+};
+
+static LIST_HEAD(mctp_pid_map);
+static DEFINE_MUTEX(mctp_pid_map_lock);
+
+int mctp_pid_map_remove(mctp_eid_t eid)
+{
+	struct mctp_pid_map_entry *entry, *tmp;
+	int found = 0;
+
+	pr_err("mctp_pid_map_remove called  : %x\n", eid);
+
+	mutex_lock(&mctp_pid_map_lock);
+	list_for_each_entry_safe(entry, tmp, &mctp_pid_map, list) {
+		if (entry->eid == eid) {
+			list_del(&entry->list);
+			kfree(entry);
+			found = 1;
+			break;
+		}
+	}
+	mutex_unlock(&mctp_pid_map_lock);
+
+	return found ? 0 : -ENOENT;
+}
+
+int mctp_pid_map_add(mctp_eid_t eid, const void *pid)
+{
+	struct mctp_pid_map_entry *entry, *tmp;
+	int ret;
+	mctp_eid_t remove_eid = MCTP_EID_INVALID;
+
+
+	//check for duplicate eid
+	mutex_lock(&mctp_pid_map_lock);
+	list_for_each_entry_safe(entry, tmp, &mctp_pid_map, list) {
+		if (entry->eid == eid) {
+			pr_err("mctp_pid_map_add entry duplicate : %x\n", eid);
+			mutex_unlock(&mctp_pid_map_lock); //unlock before return
+			return -EEXIST;
+		}
+	}
+
+	// Check if PID already exists, remove the old entry
+	list_for_each_entry_safe(entry, tmp, &mctp_pid_map, list) {
+		if (memcmp(entry->pid, pid, 6) == 0) {
+			pr_info("mctp_pid_map_add: removing existing PID mapped to EID: %x\n", eid);
+			remove_eid = entry->eid;
+			break;
+		}
+	}
+	mutex_unlock(&mctp_pid_map_lock);
+
+	if (remove_eid != MCTP_EID_INVALID) {
+		ret = mctp_pid_map_remove(remove_eid);
+		if (ret < 0)
+			return -ENOENT;
+	}
+
+	pr_info("mctp_pid_map_add: adding mapping EID:: %x\n", eid);
+	entry = kzalloc(sizeof(*entry), GFP_KERNEL);
+	if (!entry)
+		return -ENOMEM;
+
+	entry->eid = eid;
+	memcpy(entry->pid, pid, 6);
+
+	mutex_lock(&mctp_pid_map_lock);
+	list_add_tail(&entry->list, &mctp_pid_map);
+	mutex_unlock(&mctp_pid_map_lock);
+
+	return 0;
+}
+
+static int mctp_ioctl_getpidmap(struct mctp_sock *msk, unsigned long arg)
+{
+	struct mctp_pid_map_bulk bulk = {0};
+	struct mctp_pid_map_entry *entry;
+	int i = 0;
+
+	mutex_lock(&mctp_pid_map_lock);
+	list_for_each_entry(entry, &mctp_pid_map, list) {
+		if (i >= MAX_PID_MAP_ENTRIES)
+			break;
+		bulk.entries[i].eid = entry->eid;
+		memcpy(bulk.entries[i].pid, entry->pid, 6);
+		i++;
+	}
+	mutex_unlock(&mctp_pid_map_lock);
+
+	bulk.count = i;
+
+	if (copy_to_user((void __user *)arg, &bulk, sizeof(bulk)))
+	{
+		printk("mctp_ioctl_getpidmap copy_to_user error \n");
+		return -EFAULT;
+	}
+	return 0;
+}
+
+int mctp_pid_map_lookup(const void *pid, mctp_eid_t *eid_out)
+{
+	struct mctp_pid_map_entry *entry;
+	int found = 0;
+
+	mutex_lock(&mctp_pid_map_lock);
+	list_for_each_entry(entry, &mctp_pid_map, list) {
+		if (!memcmp(entry->pid, pid, 6)) {
+			*eid_out = entry->eid;
+			found = 1;
+			break;
+		}
+	}
+	mutex_unlock(&mctp_pid_map_lock);
+
+	return found ? 0 : -ENOENT;
+}
+
+static int mctp_ioctl_setpidmap(struct mctp_sock *msk, unsigned long arg)
+{
+	struct mctp_pid_map_req req;
+
+	if (copy_from_user(&req, (void __user *)arg, sizeof(req)))
+		return -EFAULT;
+
+	return mctp_pid_map_add(req.eid, req.pid);
+}
+
+static int mctp_ioctl_delpidmap(struct mctp_sock *msk, unsigned long arg)
+{
+	mctp_eid_t eid;
+
+	if (copy_from_user(&eid, (void __user *)arg, sizeof(eid)))
+		return -EFAULT;
+
+	return mctp_pid_map_remove(eid);
+}
+//ends here
+
 /* socket implementation */
 
 static void mctp_sk_expire_keys(struct timer_list *timer);
@@ -603,6 +774,12 @@ static int mctp_ioctl(struct socket *sock, unsigned int cmd, unsigned long arg)
 	case SIOCMCTPDROPTAG2:
 		tagv2 = cmd == SIOCMCTPDROPTAG2;
 		return mctp_ioctl_droptag(msk, tagv2, arg);
+	case SIOCMCTPSETPIDMAP:
+		return mctp_ioctl_setpidmap(msk, arg);
+	case SIOCMCTPDELPIDMAP:
+		return mctp_ioctl_delpidmap(msk, arg);
+	case SIOCMCTPGETPIDMAP:
+		return mctp_ioctl_getpidmap(msk, arg);
 	}
 
 	return -EINVAL;
diff --git a/net/mctp/route.c b/net/mctp/route.c
index dea5cf422e1b..1a77ec2e1dd2 100644
--- a/net/mctp/route.c
+++ b/net/mctp/route.c
@@ -1126,6 +1126,39 @@ int mctp_local_output(struct sock *sk, struct mctp_dst *dst,
 		saddr = dst->dev->addrs[0];
 		rc = 0;
 	}
+
+    /* use different eids as src eids for communication based on userdefined mappings*/
+    char daddr_buf[MAX_ADDR_LEN];
+    bool has_pid = false;
+
+    if (dst->halen > 0)
+    {
+        memcpy(daddr_buf, dst->haddr, dst->halen);
+        has_pid = true;
+    }
+    else if (mctp_neigh_lookup(dst->dev, daddr, daddr_buf) == 0)
+    {
+        has_pid = true;
+    }
+
+    if (has_pid)
+    {
+        mctp_eid_t mapped_eid;
+        if (mctp_pid_map_lookup(daddr_buf, &mapped_eid) == 0)
+        {
+            for (int i = 0; i < dst->dev->num_addrs; i++)
+            {
+                if (dst->dev->addrs[i] == mapped_eid)
+                {
+                    //printk("Using mapped src EID 0x%02x for PID\n", mapped_eid);
+                    saddr = mapped_eid;
+                    break;
+                }
+            }
+        }
+    }
+    //ends here
+
 	spin_unlock_irqrestore(&dst->dev->addrs_lock, flags);
 	netid = READ_ONCE(dst->dev->net);
 
@@ -1372,6 +1405,12 @@ static int mctp_pkttype_receive(struct sk_buff *skb, struct net_device *dev,
 	if (rc)
 		goto err_drop;
 
+    if (dst.output == mctp_dst_output) {
+        // Handle packets destined for other devices
+        skb->dev = dst.dev->dev;
+        cb->ifindex = dst.dev->dev->ifindex;
+    }
+
 	dst.output(&dst, skb);
 	mctp_dst_release(&dst);
 	mctp_dev_put(mdev);
-- 
