From ab5316a04a5e1abdc3dc6c8b151d664e4ff36ba8 Mon Sep 17 00:00:00 2001
From: kirankumarreddyt <kirankumarreddyt@ami.com>
Date: Tue, 17 Mar 2026 22:47:20 +0530
Subject: [PATCH] disable logs and  fix polling error during rescan

Upstream-Status: Inappropriate [AMI specific change]

---
 drivers/net/mctp/mctp-i3c-target.c |  2 --
 drivers/net/mctp/mctp-i3c.c        | 25 ++++++++++++-------------
 2 files changed, 12 insertions(+), 15 deletions(-)

diff --git a/drivers/net/mctp/mctp-i3c-target.c b/drivers/net/mctp/mctp-i3c-target.c
index 5ecf68686132..67ea109f2e21 100644
--- a/drivers/net/mctp/mctp-i3c-target.c
+++ b/drivers/net/mctp/mctp-i3c-target.c
@@ -118,8 +118,6 @@ static void mctp_i3c_target_read(struct i3c_device *i3cdev, const u8 *data, size
 	skb_pull(skb, sizeof(struct mctp_i3c_target_internal_hdr));
 
 	if (count < (I3C_MCTP_MIN_PACKET_SIZE + 1) || count > (I3C_MCTP_PACKET_SIZE + 1)) {
-		dev_err(i3cdev_to_dev(i3cdev),
-			" MCTP packet length invalid \n");
 		kfree_skb(skb);
 		return;
 	}
diff --git a/drivers/net/mctp/mctp-i3c.c b/drivers/net/mctp/mctp-i3c.c
index cfcb4d7c8137..5e7510a29256 100644
--- a/drivers/net/mctp/mctp-i3c.c
+++ b/drivers/net/mctp/mctp-i3c.c
@@ -297,28 +297,27 @@ static void i3c_mctp_i3c_event_cb(struct i3c_device *i3cdev, enum i3c_event even
 		/* Disable IBI before rescan */
 		mctp_i3c_disable_ibi(i3cdev);
 		cancel_delayed_work(&mi->poll_work);
-		msleep(200);
+		msleep(100);
 		break;
 
 	case i3c_event_rescan_done:
 		/* Wait a bit after rescan before enabling IBI */
-		msleep(500);
-		dev_info(i3cdev_to_dev(i3cdev), "mctp-i3c: i3c_event_rescan_done\n");
+		msleep(300);
+		//dev_info(i3cdev_to_dev(i3cdev), "mctp-i3c: i3c_event_rescan_done\n");
 
 		/* Get updated device info */
 		i3c_device_get_info(i3cdev, &info);
-		dev_info(i3cdev_to_dev(i3cdev),
-			 "mctp-i3c: Device PID: %016llx, Dynamic Addr: 0x%02x\n",
-			 info.pid, info.dyn_addr);
+		//dev_info(i3cdev_to_dev(i3cdev),
+		//	 "mctp-i3c: Device PID: %016llx, Dynamic Addr: 0x%02x\n",
+		//	 info.pid, info.dyn_addr);
 
 		/* Re-request and enable IBI after rescan */
-		if (mctp_i3c_enable_ibi(i3cdev)) {
-			dev_info(i3cdev_to_dev(i3cdev),
-				 "mctp-i3c: falling back to polling after rescan as ibi enable failed\n");
-			INIT_DELAYED_WORK(&mi->poll_work, mctp_i3c_poll_work);
-			schedule_delayed_work(&mi->poll_work,
-					      msecs_to_jiffies(POLLING_TIMEOUT_MS));
-		}
+	       if (mctp_i3c_enable_ibi(i3cdev)) {
+		       if(!delayed_work_pending(&mi->poll_work)) {
+			       INIT_DELAYED_WORK(&mi->poll_work, mctp_i3c_poll_work);
+			       schedule_delayed_work( &mi->poll_work, msecs_to_jiffies(POLLING_TIMEOUT_MS));
+		       }
+	       }
 		break;
 
 	default:
-- 
2.34.1

